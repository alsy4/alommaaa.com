---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
  /** Re-sort by date descending. Set false when the caller has already
   * ordered `posts` (e.g. a project page ordering its series by number). */
  sortByDate?: boolean;
}

const { posts, sortByDate = true } = Astro.props;

const sorted = [...posts].filter((p) => !p.data.draft);
if (sortByDate) {
  sorted.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
  );
}
---

{
  sorted.length === 0 ? (
    <p class="muted">No posts yet.</p>
  ) : (
    <div class="post-feed">
      {sorted.map((post) => (
        <article class="post-card">
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="muted">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
            {post.data.tags.length > 0 && (
              <>
                {" "}
                &mdash; {post.data.tags.join(", ")}
              </>
            )}
          </p>
          <p class="description">{post.data.description}</p>
        </article>
      ))}
    </div>
  )
}
