---
// src/components/SysInfo.astro

interface Props {
  username?: string;
  hostname?: string;
}

const { username = "developer", hostname = "portfolio" } = Astro.props;

const sysData = [
  { label: "OS", value: "Astro OS x86_64" },
  { label: "Host", value: "Web Browser (V8 Engine)" },
  { label: "Kernel", value: "6.10.2-arch1-1" },
  { label: "Uptime", value: "24 years, 3 months" }, // Your age or experience duration
  { label: "Shell", value: "zsh 5.9" },
  { label: "Display", value: "1920x1080 @ 144Hz" },
  { label: "Role", value: "Full-Stack Software Engineer" },
  { label: "Stack", value: "TypeScript, React, Astro, Node.js, Tailwind" },
  { label: "Location", value: "Remote / Planet Earth" },
  { label: "Terminal", value: "iTerm2" },
  { label: "CPU", value: "Human Brain @ 3.50GHz (8 cores)" },
  { label: "Memory", value: "64GB / 128GB (Coffee Fueled)" },
];

// Custom ASCII logo or text emblem
const asciiLogo = `
     /\\
    /  \\
   / /\\ \\
  / /  \\ \\
 / / /\\ \\ \\
/_/ /  \\ \\_\\
    \\  /
     \\/
`;
---

<div class="sysinfo-container font-mono text-sm max-w-2xl mx-auto my-8 p-6 bg-slate-950 text-slate-100 rounded-lg shadow-xl border border-slate-800">
  <!-- Terminal Header Bar -->
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
    <div class="flex gap-2">
      <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
    </div>
    <span class="text-xs text-slate-500">user@{hostname}: ~</span>
  </div>

  <!-- Main Fastfetch Content -->
  <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
    <!-- ASCII Art Side -->
    <pre class="sm:col-span-4 text-cyan-400 font-bold leading-tight select-none text-xs sm:text-sm overflow-x-auto">
{asciiLogo}
    </pre>

    <!-- System Info Side -->
    <div class="sm:col-span-8 space-y-1">
      <!-- Title Header: user@host -->
      <div class="text-base font-bold pb-1 mb-2 border-b border-slate-800">
        <span class="text-cyan-400">{username}</span><span class="text-slate-400">@</span><span class="text-cyan-400">{hostname}</span>
      </div>

      <!-- Key-Value Pairs -->
      {sysData.map(item => (
        <div class="grid grid-cols-3 gap-2">
          <span class="text-cyan-400 font-bold">{item.label}:</span>
          <span class="col-span-2 text-slate-300">{item.value}</span>
        </div>
      ))}

      <!-- Fastfetch Color Palette Bar -->
      <div class="pt-4 flex gap-1">
        <span class="w-4 h-4 bg-black rounded-sm border border-slate-700"></span>
        <span class="w-4 h-4 bg-red-500 rounded-sm"></span>
        <span class="w-4 h-4 bg-green-500 rounded-sm"></span>
        <span class="w-4 h-4 bg-yellow-500 rounded-sm"></span>
        <span class="w-4 h-4 bg-blue-500 rounded-sm"></span>
        <span class="w-4 h-4 bg-fuchsia-500 rounded-sm"></span>
        <span class="w-4 h-4 bg-cyan-500 rounded-sm"></span>
        <span class="w-4 h-4 bg-white rounded-sm"></span>
      </div>
    </div>
  </div>
</div>
