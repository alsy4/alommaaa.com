---

<div class="sysinfo-container text-sm max-w-2xl mx-auto my-8 p-6 bg-[var(--bg)] text-[var(--fg)] rounded border border-[var(--border)]">
  <!-- Terminal Header Bar -->
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-[var(--border)]">
    <div class="flex gap-2">
      <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-[var(--accent)] inline-block"></span>
    </div>
    <span class="text-xs text-[var(--muted)]">user@HOSTNAME: ~</span>
  </div>

  <!-- Main Fastfetch Content -->
  <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
    <!-- ASCII Art Side -->
    <pre class="ascii-art sm:col-span-4 mx-auto w-fit text-[var(--accent)] font-bold leading-tight select-none text-xs sm:text-sm overflow-x-auto">
{asciiLogo}
    </pre>

    <!-- System Info Side -->
    <div class="sm:col-span-8 space-y-1">
      <!-- Title Header: user@host -->
      <div class="text-base font-bold pb-1 mb-2 border-b border-[var(--border)]">
        <span class="text-[var(--accent)]">about</span><span class="text-[var(--muted)]">@</span><span class="text-[var(--accent)]">me</span>
      </div>

      <!-- Key-Value Pairs -->
      {sysData.map(item => (
        <div class="grid grid-cols-3 gap-2">
          <span class="text-[var(--accent)] font-bold">{item.label}</span>
          <span class="col-span-2 text-[var(--fg)]">{item.value}</span>
        </div>
      ))}

      <!-- Social / Certification Links -->
      <div class="grid grid-cols-3 gap-2 pt-4">
        <span></span>
        <div class="col-span-2 flex items-center gap-3">
          {socialLinks.map(link => (
            <a
              href={link.mailto ? "#" : link.href}
              target={link.mailto ? undefined : "_blank"}
              rel={link.mailto ? undefined : "noopener noreferrer"}
              aria-label={link.label}
              title={link.label}
              style={`color: ${link.color}`}
              class="opacity-90 hover:opacity-100 transition-opacity"
              data-email-link={link.mailto ? "" : undefined}
              data-u={link.mailto ? link.emailUser : undefined}
              data-d={link.mailto ? link.emailDomain : undefined}
            >
              <svg
                class="h-5 w-auto"
                viewBox={link.viewBox ?? "0 0 20 20"}
                fill="currentColor"
                set:html={link.icon}
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initEmailLink() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-email-link]");

    links.forEach((link) => {
      const { u, d } = link.dataset;
      if (!u || !d) return;

      const user = atob(u);
      const domain = atob(d);
      link.href = `mailto:${user}@${domain}`;
    });
  }

  initEmailLink();
</script>
