---
// src/components/SysInfo.astro

interface Props {
  username?: string;
  hostname?: string;
}

const { username = "developer", hostname = "aloma" } = Astro.props;

const sysData = [
  { label: "Name", value: "Nik Alimi Syahir Bin Shaari" },
  { label: "Experience", value: "Digital Transformation Team | RHB Banking Berhad" },
  { label: "", value: "Deployment Management | epiGenesys" },
  { label: "Education", value: "The University of Sheffield | BSc Computer Science \n | First Class Honours"  },
  { label: "", value: "Kolej Mara Banting | International Baccalareate" },
  { label: "Languages", value: "Java (Spring Boot) | Ruby (Ruby on Rails) | Python (FastAPI) | Bash | SQL" },
  { label: "Skills", value: "AWS / DevOps / Automation / Linux / AIOps" },
];

const asciiLogo = [
  "　　　　　   __",
  "　　　　 ／フ   フ",
  "　　　　|  .   .|",
  "　 　　／`ミ__xノ",
  "　 　 /　　 　 |",
  "　　 /　 ヽ　　ﾉ",
  " 　 │　　 | | |",
  "／￣|　　 | | |",
  "| (￣ヽ_ヽ)_)__)",
  "＼二つ",
].join("\n");

// Social / certification links (placeholder hrefs — fill in with real URLs)
const socialLinks = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/nik-alimi-syahir-shaari-404b1a326/",
    color: "#0A66C2",
    icon: `<path d="M4.98 3.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM.5 8h4v12h-4V8zm7.5 0h3.8v1.7h.1c.5-1 1.9-2 3.9-2 4.2 0 5 2.8 5 6.3V20h-4v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20h-4V8z"/>`,
  },
  {
    label: "GitHub",
    href: "https://github.com/alsy4",
    color: "#FFFFFF",
    icon: `<path d="M10 .3a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.93 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.68-4.57 4.92.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 10 .3z"/>`,
  },
  {
    label: "AWS Certification",
    href: "https://www.credly.com/badges/8a31ad76-f2aa-4028-9a2f-beb625a4fd39/linked_in_profile",
    color: "#FF9900",
    viewBox: "0 0 40 22",
    icon: `<text x="0" y="15" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="800" fill="currentColor">aws</text><path d="M1 19c8 5 25 5 33 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M29 15.5l5 3-2.2 4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    label: "Email",
    mailto: true,
    // Encoded so the address never appears as plain text in the built HTML —
    // assembled client-side by the script below. Defeats basic regex/text
    // scrapers; not intended as strong cryptographic protection.
    emailUser: Buffer.from("syahiralimi").toString("base64"),
    emailDomain: Buffer.from("gmail.com").toString("base64"),
    color: "var(--accent)",
    icon: `<rect x="1" y="4" width="18" height="12" rx="1" ry="1" fill="none" stroke="currentColor" stroke-width="1"/><path d="M2 5l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
