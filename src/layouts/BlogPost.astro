---
import "katex/dist/katex.min.css";
import Layout from "./Layout.astro";
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, date, updated, tags } = post.data;

const dateFormatted = date.toISOString().slice(0, 10);
const updatedFormatted = updated ? updated.toISOString().slice(0, 10) : null;

const projects = (
  await Promise.all(post.data.projects.map((p) => getEntry(p)))
).filter((p) => p !== undefined);
---

<Layout title={`${title} · alome`} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="muted">
        <time datetime={date.toISOString()}>{dateFormatted}</time>
        {updated && (
          <>
            {" "}
            &mdash; updated <time datetime={updated.toISOString()}>{updatedFormatted}</time>
          </>
        )}
        {tags.length > 0 && (
          <>
            {" "}
            &mdash; {tags.join(", ")}
          </>
        )}
      </p>
      {projects.length > 0 && (
        <p class="muted">
          Part of project(s):{" "}
          {projects.map((project, i) => (
            <>
              {i > 0 && ", "}
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            </>
          ))}
        </p>
      )}
    </header>
    <slot />
  </article>
</Layout>
