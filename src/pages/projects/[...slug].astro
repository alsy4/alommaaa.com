---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, date, tags } = project.data;
const { Content } = await render(project);

const dateFormatted = date.toISOString().slice(0, 10);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((post) => post.data.projects.some((p) => p.id === project.id))
  .flatMap((post) => {
    // File name must start with a numbering prefix (e.g. "01-" or "01_") to
    // place it in the series — undated/unnumbered posts are dropped.
    const match = post.id.split("/").pop()?.match(/^\d+/);
    return match ? [{ post, order: Number(match[0]) }] : [];
  })
  .sort((a, b) => a.order - b.order)
  .map(({ post }) => post);
---

<Layout title={`${title} · alome`} description={description}>
  <article>
    <header class="text-center">
      <h1>{title}</h1>
      <p class="muted">
        <time datetime={date.toISOString()}>{dateFormatted}</time>
        {tags.length > 0 && (
          <>
            {" "}| {tags.join(", ")}
          </>
        )}
      </p>
      <p>{description}</p>
    </header>
    <Content />
  </article>

  <PostList posts={posts} sortByDate={false} />
</Layout>
